@model Skoruba.IdentityServer4.Admin.BusinessLogic.Identity.ViewModels.Account.LoginViewModel

@{
    Layout = null; // Single-page self-contained layout to prevent collision with Skoruba's admin themes
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Masuk - Kopi Mardika</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/bundle.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4 selection:bg-primary-500 selection:text-white font-sans antialiased text-slate-800">

    <!-- Outer Login Container Card -->
    <div class="w-full max-w-[440px] bg-white rounded-3xl p-8 sm:p-10 shadow-xl shadow-slate-200/50 border border-slate-100 flex flex-col gap-8 my-8">
        
        <!-- Logo & Title Section -->
        <div class="flex flex-col items-center text-center gap-2">
            <!-- Brand Logo (uses the relative URL mapped through the BFF) -->
            <img src="/logo-1.webp" alt="Kopi Mardika Logo" class="h-16 w-auto object-contain mb-2" onerror="this.src='/logo/logo-1.webp'" />
            <h1 class="font-display font-bold text-3xl tracking-tight text-slate-900">Kopi Mardika</h1>
            <p class="text-sm text-slate-500 font-medium font-sans">Lorem Ipsum Dolor Sit Amet</p>
        </div>

        <!-- Login Card -->
        <div class="bg-white p-8 rounded-2xl shadow-lg border border-slate-100 flex flex-col gap-6">
            <div class="flex flex-col gap-1">
                <h2 class="text-xl font-bold text-slate-900 font-sans">Selamat Datang Kembali</h2>
                <p class="text-xs text-slate-500">Silakan masuk menggunakan akun Anda</p>
            </div>

            <!-- Server-side validation alerts -->
            @if (!ViewContext.ModelState.IsValid)
            {
                <div class="bg-rose-50 border border-rose-100 text-[#B61919] p-3 rounded-xl text-xs flex flex-col gap-1">
                    <div class="flex items-center gap-1.5 font-bold">
                        <i class="bx bxs-error-circle text-base"></i>
                        <span>Gagal Masuk</span>
                    </div>
                    <div asp-validation-summary="All" class="validation-summary list-none pl-0 mt-1 font-medium"></div>
                </div>
            }

            <form asp-route="Login" method="post" class="flex flex-col gap-4">
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Username/Email Input -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Username" class="text-xs font-semibold text-slate-700">Username atau Email</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                            <i class="bx bx-user text-lg"></i>
                        </div>
                        <input asp-for="Username" type="text" placeholder="Masukkan username Anda" 
                               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:border-[#B61919] focus:ring-2 focus:ring-[#B61919]/20 focus:outline-none text-sm transition-all duration-200 placeholder:text-slate-400"
                               required autofocus />
                    </div>
                    <span asp-validation-for="Username" class="text-[11px] text-[#B61919] font-medium"></span>
                </div>

                <!-- Password Input -->
                <div class="flex flex-col gap-1.5">
                    <div class="flex justify-between items-center">
                        <label asp-for="Password" class="text-xs font-semibold text-slate-700">Kata Sandi</label>
                    </div>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                            <i class="bx bx-lock-alt text-lg"></i>
                        </div>
                        <input asp-for="Password" type="password" placeholder="••••••••" 
                               class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-slate-200 focus:border-[#B61919] focus:ring-2 focus:ring-[#B61919]/20 focus:outline-none text-sm transition-all duration-200 placeholder:text-slate-400"
                               required autocomplete="off" />
                        <!-- Toggle Password Viewer -->
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 cursor-pointer">
                            <i id="passwordToggleIcon" class="bx bx-show text-lg"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-[11px] text-[#B61919] font-medium"></span>
                </div>

                <!-- Remember Me Checkbox -->
                @if (Model.AllowRememberLogin)
                {
                    <div class="flex items-center justify-between mt-1">
                        <label class="flex items-center gap-2 cursor-pointer select-none">
                            <input asp-for="RememberLogin" type="checkbox" 
                                   class="h-4 w-4 rounded border-slate-300 text-[#B61919] focus:ring-[#B61919] focus:ring-offset-0 focus:outline-none" />
                            <span class="text-xs text-slate-600 font-medium">Ingat saya di perangkat ini</span>
                        </label>
                    </div>
                }

                <!-- Action Buttons -->
                <div class="flex flex-col gap-2 mt-4">
                    <button type="submit" name="button" value="login" 
                            class="w-full bg-[#B61919] hover:bg-[#9B1515] text-white py-3 rounded-xl font-semibold text-sm transition-all duration-200 active:scale-98 shadow-sm flex justify-center items-center gap-2 cursor-pointer">
                        <span>Masuk Sekarang</span>
                        <i class="bx bx-right-arrow-alt text-lg"></i>
                    </button>
                    <button type="submit" name="button" value="cancel" 
                            class="w-full bg-slate-50 hover:bg-slate-100 text-slate-600 py-2.5 rounded-xl font-medium text-xs transition-all duration-200 active:scale-98 border border-slate-200 cursor-pointer">
                        Kembali
                    </button>
                </div>
            </form>
        </div>

        <!-- Footer Info -->
        <div class="text-center">
            <p class="text-[11px] text-slate-400 font-medium">&copy; 2026 Kopi Mardika. All rights reserved.</p>
        </div>
    </div>

    <!-- Password visibility toggle script -->
    <script>
        function togglePasswordVisibility() {
            var pwdField = document.getElementById("Password");
            var icon = document.getElementById("passwordToggleIcon");
            if (pwdField.type === "password") {
                pwdField.type = "text";
                icon.className = "bx bx-hide text-lg";
            } else {
                pwdField.type = "password";
                icon.className = "bx bx-show text-lg";
            }
        }
    </script>

</body>
</html>

# Malakabooks Store - Apache Shared Hosting Configuration (.htaccess)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. HTTPS redirect
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]


  # 4. Serve existing files or directories directly (JS, CSS, images, ngsw files)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Angular SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache-Control & Expires Headers
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML & ngsw.json - no cache so updates are immediate
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"

  # Bundled JS & CSS with hashes - cache long term (1 year)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"

  # Media & Fonts
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Service Worker (ngsw) - must not be cached by browser
<IfModule mod_headers.c>
  <FilesMatch "ngsw\.json$|ngsw-worker\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

{
  "IS4Setting": {
    "IdentityServerBaseUrl": "http://192.168.1.15:44310",
    "ApiName": "MalakaBooks_Service",
    "RequireHttpsMetadata": false,
    "PolicySettings": {
      "Roles": [
        {
          "Policy": "MalakaAdminPolicy",
          "Name": [ "Malaka-Admin" ]
        },
        {
          "Policy": "MalakaCustomerPolicy",
          "Name": [ "Malaka-Admin", "Malaka-Customer" ]
        }
      ],
      "Scopes": [
        {
          "Policy": "CreatePolicy",
          "Name": [ "Create" ]
        },
        {
          "Policy": "ReadPolicy",
          "Name": [ "Read" ]
        },
        {
          "Policy": "UpdatePolicy",
          "Name": [ "Update" ]
        },
        {
          "Policy": "DeletePolicy",
          "Name": [ "Delete" ]
        },
        {
          "Policy": "ScopesPolicy",
          "Name": [ "Create", "Read", "Update", "Delete" ]
        }
      ],
      "Claims": [
        {
          "Policy": "ClaimsPolicy",
          "Entries": [
            {
              "Name": "client_id",
              "Values": [ "MalakaBooks-FE" ]
            }
          ]
        }
      ]
